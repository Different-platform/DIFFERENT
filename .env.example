# Copy to .env and fill in. .env is gitignored.

# --- Database ---
# Local dev: matches docker-compose.yml. Swap for the Supabase pooled
# connection string when deploying; it is plain Postgres either way.
DATABASE_URL=postgresql://differ:differ@localhost:5432/differ

# --- LLM ---
# Required for real answers. Without it the API falls back to
# FakeLLMGateway, which returns scripted responses (see llm/gateway.py).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Embeddings ---
# Must be identical between the ingestion job and the API at query time,
# or retrieval silently returns nonsense (Requirement 13.3).
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# --- Ingestion ---
# Directory holding the NHIS codebook PDFs and survey CSVs. Source data is
# never committed to the repo.
NHIS_DATA_DIR=/Users/pukhraj/Desktop/Chatbot/Dataset

# --- Rate limiting ---
RATE_LIMIT_MAX=50
RATE_LIMIT_WINDOW_SECONDS=3600

# --- CORS ---
# The Vite dev server origin, so the browser can reach the API locally.
FRONTEND_ORIGIN=http://localhost:5173
