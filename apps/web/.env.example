# Frontend (Next.js) environment. Copy to .env.local; .env.local is gitignored.
#
# SERVER-ONLY. None of these are NEXT_PUBLIC_, so Next.js refuses to inline
# them into client code — the browser never sees the backend URL or secret.

# Base URL of the FastAPI backend the proxy forwards to.
API_BASE_URL=http://127.0.0.1:8100

# Shared secret sent as x-api-secret to the backend. Leave empty for local dev
# if the backend does not yet require it; set in production.
API_SHARED_SECRET=
